# =====================================================================
# Google Gemini API Configuration for AI Document Comparison Assistant
# =====================================================================
# Paste your actual Gemini API key below.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Default Gemini Model (gemini-3.8-flash is currently supported and recommended)
GEMINI_MODEL=gemini-3.8-flash

# Maximum allowed file upload size in megabytes
MAX_FILE_SIZE_MB=25

# Maximum allowed pages per document
MAX_PAGE_COUNT=50
